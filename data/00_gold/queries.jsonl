{"query_id": "q_p01_01", "person_id": "p01", "text": "毎朝飲んでいる高血圧の薬のこと、覚えていますか。", "query_type": "direct", "filters": {"date_from": null, "date_to": null, "category": null}, "asked_on": "2026-11-01", "split": "dev", "note": "事実とほぼ同じ語"}
