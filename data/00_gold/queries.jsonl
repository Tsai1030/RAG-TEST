{"query_id": "q_p01_07", "person_id": "p01", "text": "お茶を飲みに行き来しているお隣さんのお名前、何でしたかしら。", "query_type": "person", "filters": {"date_from": null, "date_to": null, "category": null}, "asked_on": "2026-11-01", "split": "test", "note": "p18 にも近所付き合いの事実あり"}
